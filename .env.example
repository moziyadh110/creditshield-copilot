# Copy to .env and fill in. Never commit .env.

# Postgres + pgvector (docker-compose.yml, host port 5433; CreditShield owns 5432)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5433/copilot

# LLM provider (OpenAI-compatible). Key needed from Day 2 onwards.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Local embedding model (no paid calls during ingest)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where denial cases come from: file (data/denials.parquet) or api (live CreditShield)
CASE_SOURCE=file
CREDITSHIELD_API_URL=http://localhost:8000
CREDITSHIELD_API_KEY=

# MLflow tracking server (host port 5001)
MLFLOW_TRACKING_URI=http://localhost:5001

# Optional daily LLM spend cap in USD. Unset = no cap (cost is still logged). Set before any public demo.
DAILY_BUDGET_USD=
